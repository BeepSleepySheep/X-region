<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- miuix-blur needs API 33+; on older devices the blur toggle is a no-op guarded at runtime.
         与 XBlocker app/src/main/AndroidManifest.xml:4 完全一致。 -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <queries>
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:label="XRegion"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!-- MainActivity 只承载 LSPosed 模块入口；隐藏桌面图标不会影响它。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="XRegion"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标由 alias 承担；隐藏时只禁用这一个组件。 -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="XRegion"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".ModuleProvider"
            android:authorities="com.example.xregion.config"
            android:enabled="true"
            android:exported="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="仅对 X (com.twitter.android) 生效：伪装 TelephonyManager 的网络国家代码" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
